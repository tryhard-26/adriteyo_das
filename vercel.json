{
  "version": 2,
  "name": "adriteyo-portfolio",
  "buildCommand": "mkdir -p /tmp/hugo-bin && curl -fsSL https://github.com/gohugoio/hugo/releases/download/v0.166.0/hugo_extended_0.166.0_linux-amd64.tar.gz -o /tmp/hugo.tar.gz && tar -xzf /tmp/hugo.tar.gz -C /tmp/hugo-bin && PATH=\"$PWD/node_modules/.bin:/tmp/hugo-bin:$PATH\" hugo --gc --minify --baseURL \"https://adriteyo-das.vercel.app/\"",
  "outputDirectory": "public"
}
